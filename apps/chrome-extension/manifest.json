{
  "manifest_version": 3,
  "name": "Jarvis AI Voice Assistant",
  "version": "1.1.0",
  "description": "Ultra-low-latency voice-enabled AI agent with active tab contextual intelligence and hands-free control.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Jarvis Assistant"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "dom-actions.js", "action-confirm-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
