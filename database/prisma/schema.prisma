generator client {
  provider = "prisma-client-js"
  output   = "../../backend/services/auth-service/src/generated/prisma"
}

generator agentClient {
  provider = "prisma-client-js"
  output   = "../../backend/services/agent-service/src/generated/prisma"
}

generator workerClient {
  provider = "prisma-client-js"
  output   = "../../backend/services/worker-service/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  displayName   String?
  voicePreference      String        @default("female")
  passwordHash         String
  lastLatitude         Float?
  lastLongitude        Float?
  lastLocationLabel    String?
  locationUpdatedAt    DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sessions             Session[]
  conversations        Conversation[]
  memories             Memory[]
  browserActions       BrowserAction[]
}

model BrowserAction {
  id              String   @id @default(uuid()) @db.Uuid
  actionId        String   @unique
  userId          String   @db.Uuid
  deviceId        String?
  tabId           Int?
  conversationId  String?  @db.Uuid
  actionType      String
  riskTier        String
  payloadSummary  Json
  status          String
  failureReason   String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  browserActions BrowserAction[]
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  content        String
  role           String       // 'user' or 'assistant'
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Memory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  category  String   @default("general") // 'user_preference', 'task', 'fact', 'general'
  metadata  Json?
  vectorId  String?  // Matching point ID in Qdrant
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
}
