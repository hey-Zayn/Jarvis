PORT=5000
AUTH_SERVICE_URL=auth-service:4001
AGENT_SERVICE_URL=agent-service:4002
WORKER_SERVICE_URL=worker-service:4003
PROTO_ROOT=/shared/proto
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
JWT_SECRET=replace-with-a-local-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
WS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000
WS_ALLOWED_EXTENSION_IDS=
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_MESSAGES_PER_MINUTE=60
