{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.cache/**",
      "**/build/**",
      "**/.git/**"
    ]
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "npx prisma migrate *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "docker-compose up*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "shared/proto/*.proto",
      "effect": "ask"
    }
  ]
}